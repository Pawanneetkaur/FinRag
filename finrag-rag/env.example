# FinRAG environment variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI — platform.openai.com (used for embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# SEC EDGAR (no key needed — just set your app name + email)
EDGAR_USER_AGENT=FinRAG your@email.com

# NewsAPI — newsapi.org (free tier)
NEWS_API_KEY=your_newsapi_key_here

# Qdrant Cloud — cloud.qdrant.io
QDRANT_URL=https://your-cluster-url.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=finrag_docs

# Embedding model
EMBED_MODEL_NAME=text-embedding-3-small
EMBED_DIMENSIONS=1536

# Chunking
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
