# FinRAG environment variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Anthropic (get from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SEC EDGAR (no key needed — just set your app name + email)
EDGAR_USER_AGENT=FinRAG your@email.com

# NewsAPI (free tier at newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# Qdrant (default for local docker-compose)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finrag_docs

# Embedding model (leave as default unless you want to upgrade)
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBED_DIMENSIONS=384

# Chunking
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_N=6
